# Modelo de produção. Gere o arquivo real com: sh deploy/setup.sh
# O .env.production nunca vai para o git.

# Endereço público, sem https://
DOMAIN=financas.seudominio.com.br

# caddy: servidor com as portas 80 e 443 abertas. tunnel: túnel da Cloudflare.
COMPOSE_PROFILES=caddy

# Gere com: openssl rand -hex 24
DB_PASSWORD=
# Gere com: openssl rand -hex 32
SECRET_KEY=
# Só para o perfil tunnel
TUNNEL_TOKEN=

# 0: só a primeira conta pode se cadastrar. 1: qualquer pessoa pode criar conta.
REGISTRATION_OPEN=0

# Login social: vazio deixa o botão desativado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Coloque o arquivo .p8 em secrets/ e informe, por exemplo: /app/secrets/apple.p8
APPLE_PRIVATE_KEY_PATH=
