# Gerado automaticamente por: .\scripts\db.ps1 init
DATABASE_URL=postgresql+psycopg://monetta:SENHA@127.0.0.1:5433/monetta
TEST_DATABASE_URL=postgresql+psycopg://monetta:SENHA@127.0.0.1:5433/monetta_test
SECRET_KEY=
APP_TIMEZONE=America/Sao_Paulo
PUBLIC_URL=http://localhost:4200

# Login social: deixe vazio e o botão correspondente fica desativado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Retorno do Google quando o app roda em monetta.localhost (o MONETTA.cmd já define).
OAUTH_REDIRECT_BASE=

# Recuperação de senha por e-mail. Vazio: o link aparece na janela do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
